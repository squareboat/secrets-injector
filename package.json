{
  "name": "secrets-injector",
  "version": "1.1.4",
  "description": "NestJS AWS Secrets Injector",
  "author": "Anubhavjain786",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "nestjs",
    "aws",
    "aws-secrets-manager",
    "secrets-management",
    "environment-variables",
    "config",
    "process.env",
    "nestjs-module",
    "aws-sdk",
    "configuration",
    "secret-injection",
    "dotenv",
    "secrets-injector",
    "secure-config",
    "nodejs",
    "environment-variable-injection",
    "nestjs-config"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "check-types": "tsc --pretty --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public"
  },
  "peerDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/schematics": "^12.0.12",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "~anubhavjain786:registry": "https://npm.pkg.github.com"
  },
  "volta": {
    "node": "22.23.2"
  },
  "homepage": "https://github.com/Anubhavjain786/secrets-injector#readme",
